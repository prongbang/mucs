# Copy to .env and fill in. Both `docker compose up` and `cargo run` read this
# file — it deliberately holds no container-only paths, so the same copy works
# either way. Deployment paths (DATABASE_URL, WORK_DIR, ...) live in
# docker-compose.yml instead.

# ---- RustFS (S3) ----
S3_ENDPOINT=http://127.0.0.1:9000
# Host the browser downloads stems from. Only needs setting when the app and
# the browser reach RustFS at different addresses; defaults to S3_ENDPOINT.
#S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=mucs
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
PRESIGN_SECS=900

# ---- Encryption ----
# Both keys are 32 bytes of hex: `openssl rand -hex 32`.
#
# AUDIO_KEY turns on encryption for the audio itself: the console seals uploads
# before they leave the browser, RustFS only ever stores ciphertext, and stems
# come back sealed. Leave it unset to keep storing audio in the clear — turning
# it on later is safe (existing plaintext objects still play), but turning it
# off or changing it makes everything uploaded under it unreadable.
#AUDIO_KEY=
#
# E2EE_SHARED_KEY is optional and only for non-browser clients: it lets curl or
# a script talk to the encrypted JSON API without doing the X25519 handshake.
# The console never needs it.
#E2EE_SHARED_KEY=

# ---- Demucs ----
DEMUCS_MODEL=htdemucs
DEMUCS_JOBS=1
DEMUCS_SEGMENT=7
DEMUCS_THREADS=4
DEMUCS_FORMAT=mp3
JOB_TIMEOUT_SECS=3600
